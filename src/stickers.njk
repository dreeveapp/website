{% extends "layouts/base.njk" %}

{% block content %}

<main>
    <section class="bg-white max-w-6xl mx-auto px-4 sm:px-5 pt-10 pb-14 md:pt-14 md:pb-20">
        <div class="max-w-3xl mx-auto text-center">
            <span class="eyebrow">Free stickers</span>
            <h1 class="mt-4 text-[1.75rem] sm:text-3xl md:text-4xl font-black text-gray-900 leading-[1.1] tracking-tight max-w-4xl mx-auto">
                Get free Dreeve <span class="text-strava-orange">stickers</span>
            </h1>
            <p class="mt-4 text-base md:text-lg text-gray-600 max-w-2xl mx-auto">
                Leave your address and we'll mail you a free Dreeve sticker.
                Once it arrives, stick it anywhere you ride, run or workout, and send a photo
                with the coordinates to <a href="mailto:hello@dreeve.app" class="inline-link">hello@dreeve.app</a>.
                Later on we'll build a map of Dreeve stickers around the globe :)
            </p>
        </div>
        <div class="mt-10 max-w-2xl mx-auto">
            <img src="assets/dreeve-stickers.jpg" alt="A pile of round orange Dreeve.app stickers on a wooden table"
                 width="1932" height="2415" class="block w-full max-w-sm h-auto mx-auto mb-10 rounded-xl"/>
            <iframe data-tally-src="https://tally.so/embed/GeK8x2?alignLeft=1&amp;hideTitle=1&amp;transparentBackground=1&amp;dynamicHeight=1"
                    loading="lazy" width="100%" height="500" frameborder="0" title="Sticker request form"></iframe>
