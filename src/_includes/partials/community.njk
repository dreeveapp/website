<div class="max-w-4xl mx-auto px-4 sm:px-5 py-14 md:py-20 text-center">
            <h2 class="section-title">Come say hi.</h2>
            <p class="mt-3 text-gray-600 max-w-2xl mx-auto">
                Dreeve is built by athletes, for athletes. Share ideas, report bugs or just chat about your last ride.
            </p>
            <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
                <a href="{{ site.githubUrl }}" target="_blank" rel="noopener" class="btn btn-dark">
                    {% include "icons/github.njk" %}
                    GitHub
                </a>
                <a href="{{ site.discordUrl }}" target="_blank" rel="noopener" class="btn btn-discord">
                    {% include "icons/discord.njk" %}
                    Join Discord
                </a>
                <a href="/stickers" class="btn btn-outline bg-white">
                    <img src="{{ site.logoUrl }}" alt="" class="size-4"/>
                    Get a free sticker
                </a>
            </div>
        </div>
